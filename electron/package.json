{
  "name": "devo-desktop",
  "version": "0.1.0",
  "author": {
    "name": "Devo AI Coding Agent",
    "email": "1342104001@qq.com"
  },
  "description": "Devo AI Coding Agent - Desktop Application",
  "homepage": "https://github.com/Bean-jun/devo",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "package": "electron-builder"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.devo.desktop",
    "productName": "devo-desktop",
    "win": {
      "target": "portable",
      "icon": "resources/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "resources/icon.png",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
